# Add these as server-side environment variables in your deployment platform (never commit real secrets).
SERPAPI_KEY=your_private_serpapi_key
# Optional private shared passcode to prevent public visitors exhausting free search credits.
SEARCH_ACCESS_CODE=your_private_code
# Optional OpenAI-compatible chat API; live product search works WITHOUT this key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://newapi.omgteam.me/v1
OPENAI_MODEL=gpt-5.6-luna
